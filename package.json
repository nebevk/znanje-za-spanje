{
  "name": "eleventy-decap-site",
  "version": "1.0.0",
  "scripts": {
    "dev:eleventy": "node node_modules/@11ty/eleventy/cmd.js --serve",
    "dev:css": "node node_modules/tailwindcss/lib/cli.js -c tailwind.config.js -i src/styles/tailwind.css -o assets/css/main.css --watch",
    "start": "npm-run-all -p dev:*",
    "build:css": "node node_modules/tailwindcss/lib/cli.js -c tailwind.config.js -i src/styles/tailwind.css -o assets/css/main.css --minify",
    "build": "npm run build:css && node node_modules/@11ty/eleventy/cmd.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.24",
    "fuse.js": "^7.4.2",
    "js-yaml": "^3.14.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
