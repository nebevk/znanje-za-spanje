{
  "name": "eleventy-decap-site",
  "version": "1.0.0",
  "scripts": {
    "dev:eleventy": "npx @11ty/eleventy --serve",
    "dev:css": "npx tailwindcss -c tailwind.config.js -i src/styles/tailwind.css -o assets/css/main.css --watch",
    "start": "npm-run-all -p dev:*",
    "build:css": "npx tailwindcss -c tailwind.config.js -i src/styles/tailwind.css -o assets/css/main.css --minify",
    "build": "npm run build:css && npx @11ty/eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.24",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
