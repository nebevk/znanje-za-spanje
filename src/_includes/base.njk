<!doctype html>
<html lang="sl" data-theme="zzs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ title | default(site.brand) }} - {{ site.brand or "Teta Luna" }}</title>
  <meta name="description" content="{{ site.tagline or 'Znanje za spanje' }}. Svetovanje za spanje dojenčkov in malčkov pri Evi, {{ site.brand or 'Teta Luna' }}." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/main.css" />
  <script type="text/javascript" src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="min-h-screen flex flex-col bg-base-200">
  <header class="navbar py-3 md:py-4 bg-base-100/80 backdrop-blur sticky top-0 z-30 border-b border-base-300">
    <div class="max-w-5xl mx-auto w-full px-4 flex items-center justify-between gap-2">
      <a href="/" class="flex items-center gap-3 min-w-0">
        <div class="avatar shrink-0">
          <div class="w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 rounded-full">
            <img src="/assets/images/logo.png" alt="Logo {{ site.brand or 'Teta Luna' }}" width="200" height="200" />
          </div>
        </div>
        <div class="leading-tight min-w-0">
          <div class="font-display text-lg sm:text-xl md:text-2xl font-semibold truncate">{{ site.brand or "Teta Luna" }}</div>
          <div class="text-xs sm:text-sm text-base-content/60 truncate -mt-0.5">{{ site.tagline or "Znanje za spanje" }}</div>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-1">
        <a href="/" class="btn btn-ghost btn-sm rounded-full">Domov</a>
        <a href="/o-meni" class="btn btn-ghost btn-sm rounded-full">O meni</a>
        <a href="/storitve" class="btn btn-ghost btn-sm rounded-full">Storitve</a>
        <a href="/blog" class="btn btn-ghost btn-sm rounded-full">Blog</a>
        <a href="/kontakt" class="btn btn-primary btn-sm">Rezerviraj posvet</a>
      </nav>
      <div class="dropdown dropdown-end md:hidden">
        <label tabindex="0" class="btn btn-ghost btn-circle" aria-label="Meni">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </label>
        <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
          <li><a href="/">Domov</a></li>
          <li><a href="/o-meni">O meni</a></li>
          <li><a href="/storitve">Storitve</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/kontakt" class="text-primary font-semibold">Rezerviraj posvet</a></li>
        </ul>
      </div>
    </div>
  </header>

  <main class="flex-1">
    {{ content | safe }}
  </main>

  <footer class="bg-neutral text-neutral-content mt-12">
    <div class="max-w-5xl mx-auto px-6 py-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10">

      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="avatar">
            <div class="w-10 h-10 rounded-full bg-base-100">
              <img src="/assets/images/logo.png" alt="Logo Znanje za Spanje" width="200" height="200" loading="lazy" />
            </div>
          </div>
          <span class="font-display text-xl font-semibold">{{ site.brand or "Teta Luna" }}</span>
        </div>
        <p class="text-sm opacity-80 max-w-sm leading-relaxed">Svetovanje za spanje dojenčkov in malčkov. Nežno, postopno in brez stresa. Eva, fizioterapevtka in svetovalka za spanje.</p>
        <div class="flex gap-2 pt-1">
          <a href="https://instagram.com/{{ site.instagram | replace('@', '') }}" target="_blank" rel="noopener" aria-label="Instagram" class="btn btn-circle btn-sm btn-ghost hover:bg-neutral-content/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="mailto:{{ site.email }}" aria-label="Email" class="btn btn-circle btn-sm btn-ghost hover:bg-neutral-content/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-display font-semibold mb-3">Strani</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="opacity-80 hover:opacity-100 hover:underline">Domov</a></li>
          <li><a href="/o-meni" class="opacity-80 hover:opacity-100 hover:underline">O meni</a></li>
          <li><a href="/storitve" class="opacity-80 hover:opacity-100 hover:underline">Storitve</a></li>
          <li><a href="/blog" class="opacity-80 hover:opacity-100 hover:underline">Blog</a></li>
          <li><a href="/kontakt" class="opacity-80 hover:opacity-100 hover:underline">Kontakt</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold mb-3">Kontakt</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="mailto:{{ site.email }}" class="opacity-80 hover:opacity-100 hover:underline break-all">{{ site.email }}</a></li>
          <li><a href="https://instagram.com/{{ site.instagram | replace('@', '') }}" target="_blank" rel="noopener" class="opacity-80 hover:opacity-100 hover:underline">{{ site.instagram }}</a></li>
          <li class="pt-2"><a href="/kontakt" class="btn btn-secondary btn-sm">Rezerviraj posvet</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-neutral-content/10">
      <div class="max-w-5xl mx-auto px-6 py-4 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs opacity-70 text-center sm:text-left">
        <span>© {{ build.year }} {{ site.brand or "Teta Luna" }}. Vse pravice pridržane.</span>
        <span>
          Foto:
          <a href="https://unsplash.com/@ujitomo?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" target="_blank" rel="noopener" class="link link-hover">Tomoko Uji</a>
          /
          <a href="https://unsplash.com/photos/pink-and-white-flowers-under-white-sky-during-daytime-kxvn1ogpTtE?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" target="_blank" rel="noopener" class="link link-hover">Unsplash</a>
        </span>
      </div>
    </div>
  </footer>
</body>
</html>
