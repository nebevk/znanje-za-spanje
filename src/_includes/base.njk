<!doctype html>
<html lang="sl" data-theme="zzs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ title | default("Znanje za Spanje") }} — {{ site.brand or "Znanje za Spanje" }}</title>
  <meta name="description" content="Svetovanje za spanje dojenčkov in malčkov — Eva, Znanje za Spanje." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/main.css" />
  <script type="text/javascript" src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="min-h-screen flex flex-col bg-base-200">
  <header class="navbar min-h-0 py-2 bg-base-100/80 backdrop-blur sticky top-0 z-30 border-b border-base-300">
    <div class="max-w-5xl mx-auto w-full px-4 flex items-center justify-between gap-2">
      <a href="/" class="flex items-center gap-3 min-w-0">
        <div class="avatar placeholder shrink-0">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-secondary text-secondary-content">
            <span class="text-sm font-bold">ZS</span>
          </div>
        </div>
        <div class="leading-tight min-w-0">
          <div class="font-display text-base sm:text-lg font-semibold truncate">{{ site.brand or "Znanje za Spanje" }}</div>
          <div class="hidden sm:block text-xs text-base-content/60 truncate">Svetovanje za spanje dojenčkov — Eva</div>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-1">
        <a href="/" class="btn btn-ghost btn-sm rounded-full">Domov</a>
        <a href="/o-meni" class="btn btn-ghost btn-sm rounded-full">O meni</a>
        <a href="/storitve" class="btn btn-ghost btn-sm rounded-full">Storitve</a>
        <a href="/blog" class="btn btn-ghost btn-sm rounded-full">Blog</a>
        <a href="/kontakt" class="btn btn-primary btn-sm">Rezerviraj posvet</a>
      </nav>
      <div class="dropdown dropdown-end md:hidden">
        <label tabindex="0" class="btn btn-ghost btn-circle" aria-label="Meni">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </label>
        <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
          <li><a href="/">Domov</a></li>
          <li><a href="/o-meni">O meni</a></li>
          <li><a href="/storitve">Storitve</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/kontakt" class="text-primary font-semibold">Rezerviraj posvet</a></li>
        </ul>
      </div>
    </div>
  </header>

  <main class="flex-1">
    {{ content | safe }}
  </main>

  <footer class="footer footer-center bg-neutral text-neutral-content p-10 mt-12">
    <aside>
      <div class="font-display text-xl font-semibold">{{ site.brand or "Znanje za Spanje" }}</div>
      <p class="text-sm opacity-80">© 2025 Eva — Vse pravice pridržane</p>
    </aside>
    <nav>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm items-center">
        <a href="mailto:{{ site.email }}" class="link link-hover break-all">{{ site.email }}</a>
        <span class="opacity-50 hidden sm:inline">·</span>
        <a href="https://instagram.com/{{ site.instagram | replace('@', '') }}" target="_blank" rel="noopener" class="link link-hover">{{ site.instagram }}</a>
      </div>
    </nav>
  </footer>
</body>
</html>
